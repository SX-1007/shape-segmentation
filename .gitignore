# =============================================================================
# SX Mini Project 1 - repository exclusions
# =============================================================================
#
# This repository contains C++ source code plus several large, reproducible, or
# machine-specific trees.  Rules near the top are tailored to the current
# project; the remaining rules protect future Visual Studio/CMake builds and
# helper tooling from accidentally adding generated or private files.
#
# Intentionally kept in Git (do not add blanket *.png or *.txt rules):
#   - Test_84_Signs/       required 84-image classroom input set (~2.7 MB)
#   - shape_labels.txt     labels paired with that input set
#   - *.cpp, *.h, *.bat    source and reproducible build/run scripts
#   - root-level *.md      project documentation and analysis
#
# If an ignored generated artifact must be published, prefer a GitHub Release,
# an external dataset URL, or `git add -f <path>` for a deliberate exception.


# =============================================================================
# Project-specific dependencies, downloads, builds, and generated artifacts
# =============================================================================

# Local OpenCV 4.x distribution: downloaded sources, headers, libraries, DLLs,
# samples, and build products (~881 MB).  build.bat supports setting OPENCV_DIR
# to another installation, so this dependency should not be vendored in Git.
/opencv/

# The root MSVC build created by build.bat: objects, executable, OpenCV runtime
# DLLs, debug databases, and any later incremental build state.
/build/

# Per-image masks, segmented images, montage/stage renders, and diagnostic CSVs
# created by normal batch runs (~41 MB and expected to change on every run).
/Outputs/

# Deterministically generated synthetic images, truth masks, predictions,
# metadata, and evaluation reports.  Source.cpp can recreate the whole tree.
/Synthetic_Background_Test/

# Downloaded/extracted third-party datasets (~964 MB).  Keep the small,
# human-authored provenance/reproduction note, but ignore archives and data.
/External_Datasets/**
!/External_Datasets/
!/External_Datasets/CamVid/
!/External_Datasets/CamVid/DATASET_INFO.md

# Generated external evaluation data (~692 MB): predictions, truth crops,
# diagnostics, tuning runs, CSVs, and summaries.  Preserve the three curated
# README files that explain the recorded experiments and how to reproduce them.
/External_Test_Results/**
!/External_Test_Results/
!/External_Test_Results/CamVid/
!/External_Test_Results/CamVid/README.md
!/External_Test_Results/CamVid32_HeldOut_Test/
!/External_Test_Results/CamVid32_HeldOut_Test/README.md
!/External_Test_Results/CamVid32_Improved/
!/External_Test_Results/CamVid32_Improved/README.md

# Local document-rendering exports and scratch work; neither path is consumed
# by the C++ build or runtime.
/output/
/tmp/

# Captured terminal output from a local test run; the command can regenerate it.
/results_console.txt


